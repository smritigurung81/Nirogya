<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <gradient
        android:type="radial"
        android:gradientRadius="120"
        android:startColor="#80DEEA"
        android:endColor="#26C6DA"
        android:centerX="0.5"
        android:centerY="0.5" />

    <stroke
        android:width="1dp"
        android:color="#B2EBF2" />     <!-- Light border -->

    <size
        android:width="60dp"
        android:height="60dp" />

    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp" />
</shape>