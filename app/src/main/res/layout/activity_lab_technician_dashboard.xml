<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8"
    android:padding="16dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- App Logo -->
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="12dp"
            android:src="@drawable/logo"
            android:contentDescription="App Logo" />

        <!-- Welcome Message -->
        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome Lab Technician"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#2E3A59"
            android:layout_marginTop="8dp" />

        <!-- Card Container -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:layout_marginHorizontal="8dp"
            android:elevation="6dp"
            android:padding="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Form Fields -->
                <EditText
                    android:id="@+id/etPatientId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Patient UID"
                    android:inputType="text"
                    android:backgroundTint="#607D8B"
                    android:drawableStart="@android:drawable/ic_menu_myplaces" />

                <EditText
                    android:id="@+id/etReportTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Report Title"
                    android:inputType="text"
                    android:backgroundTint="#607D8B"
                    android:layout_marginTop="10dp" />

                <EditText
                    android:id="@+id/etTechnicianName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Technician Name"
                    android:inputType="textPersonName"
                    android:backgroundTint="#607D8B"
                    android:layout_marginTop="10dp" />

                <EditText
                    android:id="@+id/etTechnicianId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Technician ID"
                    android:inputType="text"
                    android:backgroundTint="#607D8B"
                    android:layout_marginTop="10dp" />

                <!-- Spinner -->
                <Spinner
                    android:id="@+id/spinnerReportType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" />

                <!-- CBC Fields -->
                <LinearLayout
                    android:id="@+id/layoutCbcForm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:paddingTop="10dp">

                    <EditText
                        android:id="@+id/etHemoglobin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Hemoglobin (g/dL)"
                        android:inputType="numberDecimal" />

                    <EditText
                        android:id="@+id/etWBC"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="WBC (x10^9/L)"
                        android:inputType="numberDecimal"
                        android:layout_marginTop="6dp" />

                    <EditText
                        android:id="@+id/etPlatelets"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Platelets (x10^9/L)"
                        android:inputType="numberDecimal"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <!-- Lipid Profile -->
                <LinearLayout
                    android:id="@+id/layoutLipidForm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:paddingTop="10dp">

                    <EditText
                        android:id="@+id/etHDL"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="HDL (mg/dL)"
                        android:inputType="numberDecimal" />

                    <EditText
                        android:id="@+id/etLDL"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="LDL (mg/dL)"
                        android:inputType="numberDecimal"
                        android:layout_marginTop="6dp" />

                    <EditText
                        android:id="@+id/etTriglycerides"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Triglycerides (mg/dL)"
                        android:inputType="numberDecimal"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <!-- Blood Sugar -->
                <LinearLayout
                    android:id="@+id/layoutSugarForm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:paddingTop="10dp">

                    <EditText
                        android:id="@+id/etFasting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Fasting Sugar (mg/dL)"
                        android:inputType="numberDecimal" />

                    <EditText
                        android:id="@+id/etPost"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Postprandial Sugar (mg/dL)"
                        android:inputType="numberDecimal"
                        android:layout_marginTop="6dp" />

                    <EditText
                        android:id="@+id/etHbA1c"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="HbA1c (%)"
                        android:inputType="numberDecimal"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <!-- Buttons -->
                <Button
                    android:id="@+id/btnUploadReport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Upload Report"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="#4CAF50"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnViewReports"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="View My Reports"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#2196F3"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnLogout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Logout"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#F44336"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
