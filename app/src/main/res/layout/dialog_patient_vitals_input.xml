<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            android:id="@+id/etSystolic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Systolic (e.g. 120)" />

        <EditText
            android:id="@+id/etDiastolic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Diastolic (e.g. 80)" />

        <EditText
            android:id="@+id/etHeartRate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Heart Rate (e.g. 75 bpm)" />

        <EditText
            android:id="@+id/etOxygen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Oxygen Level (e.g. 98%)" />

        <EditText
            android:id="@+id/etTemperature"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Temperature (e.g. 36.5°C)" />
    </LinearLayout>
</ScrollView>
