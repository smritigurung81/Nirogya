<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F8FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- App Logo -->
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:src="@drawable/logo"
            android:contentDescription="App Logo"
            android:layout_marginBottom="12dp" />

        <!-- Welcome Message -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome, Doctor"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#333"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Assigned Patients Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Assigned Patients"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#333"
            android:layout_marginBottom="12dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAssignedPatients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:background="@android:color/white"
            android:elevation="2dp"
            android:padding="8dp"
            android:layout_marginBottom="24dp" />

        <!-- Appointment Requests Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Appointment Requests"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#333"
            android:layout_marginBottom="12dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAppointments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:background="@android:color/white"
            android:elevation="2dp"
            android:padding="8dp"
            android:layout_marginBottom="24dp" />

        <!-- Add Vitals & Notes (Hidden initially) -->
        <Button
            android:id="@+id/btnAddDoctorVitals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+ Add Vitals and Notes"
            android:backgroundTint="#4CAF50"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:padding="14dp"
            android:elevation="4dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <!-- Logout Button -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Logout"
            android:textStyle="bold"
            android:backgroundTint="#F44336"
            android:textColor="@android:color/white"
            android:padding="14dp"
            android:elevation="4dp"
            android:layout_marginBottom="32dp" />

    </LinearLayout>
</ScrollView>

