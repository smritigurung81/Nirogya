<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- App Logo and Welcome Message -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="24dp"
            android:padding="16dp">

            <ImageView
                android:id="@+id/imageLogo"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/logo"
                android:layout_marginBottom="8dp"
                android:contentDescription="@string/app_name" />

            <TextView
                android:id="@+id/tvWelcomeMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/welcome_patient"
                android:textSize="18sp"
                android:textColor="#333333"
                android:gravity="center" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#e0e0e0"
            android:layout_marginBottom="16dp" />

        <!-- Latest Vitals Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/latest_vitals_label"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#388e3c"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:id="@+id/vitalsDisplayLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#e8f5e9"
                android:padding="12dp"
                android:layout_marginBottom="8dp" />
        </LinearLayout>

        <!-- Upload Vitals Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/upload_vitals_label"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#00796b"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/etHeartRate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/heart_rate_hint"
                android:inputType="numberDecimal"
                android:autofillHints="none"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etTemperature"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/temperature_hint"
                android:inputType="numberDecimal"
                android:autofillHints="none"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etOxygen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/oxygen_level_hint"
                android:inputType="number"
                android:autofillHints="none"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnUploadVitals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/upload_vitals_button"
                android:background="#00796b"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <!-- Medical History Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/medical_history_label"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#6a1b9a"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:id="@+id/medicalHistoryLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#f3e5f5"
                android:padding="12dp"
                android:layout_marginBottom="8dp" />
        </LinearLayout>

        <!-- Update Medical History Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/update_medical_history_label"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#6a1b9a"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/etCondition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/condition_hint"
                android:autofillHints="none"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etMedication"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/medication_hint"
                android:autofillHints="none"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/note_hint"
                android:autofillHints="none"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnSaveHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/save_medical_history_button"
                android:background="#6a1b9a"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <!-- Book Appointment Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/book_appointment_label"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#0d47a1"
                android:layout_marginBottom="12dp" />

            <!-- Loading indicator for doctors -->
            <TextView
                android:id="@+id/tvDoctorLoadingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/loading_doctors"
                android:textSize="12sp"
                android:textColor="#666666"
                android:visibility="visible"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinnerDoctorName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:spinnerMode="dropdown"
                android:background="@android:drawable/btn_default"
                android:padding="8dp"
                android:contentDescription="@string/select_doctor" />

            <EditText
                android:id="@+id/etAppointmentDateTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/appointment_datetime_hint"
                android:focusable="false"
                android:clickable="true"
                android:inputType="none"
                android:autofillHints="none"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnBookAppointment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/book_appointment_button"
                android:background="#0d47a1"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <!-- Footer Space -->
        <View
            android:layout_width="match_parent"
            android:layout_height="32dp" />

    </LinearLayout>

</ScrollView>
