<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#F9F9F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Welcome, Patient"
            android:textStyle="bold"
            android:textSize="22sp"
            android:paddingBottom="12dp"
            android:textColor="#333" />

        <Button
            android:id="@+id/btnAddVitals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Vitals and Notes" />

        <Button
            android:id="@+id/btnBookAppointment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Book Appointment"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvReminder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reminder: Upcoming Appointment!"
            android:textColor="#D32F2F"
            android:paddingTop="10dp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvTodayAppointmentsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today's Appointments"
            android:textStyle="bold"
            android:textSize="18sp"
            android:paddingTop="10dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAppointmentsToday"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Vitals"
            android:textStyle="bold"
            android:textSize="18sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvVitals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Doctor's Vitals and Notes"
            android:textStyle="bold"
            android:textSize="18sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDoctorVitals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lab Reports"
            android:textStyle="bold"
            android:textSize="18sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvLabReports"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Logout"
            android:textColor="#FFF"
            android:backgroundTint="#D32F2F"
            android:layout_marginTop="20dp" />
    </LinearLayout>
</ScrollView>
