<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Section: Vitals -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter Vitals"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etSystolic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Systolic Pressure (mmHg)"
            android:inputType="number"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etDiastolic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Diastolic Pressure (mmHg)"
            android:inputType="number"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etHeartRate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Heart Rate (bpm)"
            android:inputType="number"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etOxygen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="SpO2 (%)"
            android:inputType="number"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etTemperature"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Temperature (°C)"
            android:inputType="numberDecimal"
            android:layout_marginBottom="16dp" />

        <!-- Section: SOAP Notes -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SOAP Notes"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etSubjective"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Subjective"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etObjective"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Objective"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etAssessment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Assessment"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etPlan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Plan"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:layout_marginBottom="16dp" />

        <!-- Save Button -->
        <Button
            android:id="@+id/btnSaveVitals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save"
            android:backgroundTint="@android:color/holo_green_dark"
            android:textColor="@android:color/white" />
    </LinearLayout>
</ScrollView>
